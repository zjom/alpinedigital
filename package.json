{
  "name": "alpinedigital",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm check && pnpm build && pnpm wrangler deploy && pnpm wrangler deploy -c www/wrangler.jsonc",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.78.0",
    "playwright-core": "^1.50.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.0"
}
