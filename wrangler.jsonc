{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpinedigital",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  // The site's only address. With a route set, wrangler turns workers.dev off.
  // The zone is in the same Cloudflare account, so the deploy creates the DNS
  // record and the certificate.
  "routes": [{ "pattern": "alpinedigital.com.au", "custom_domain": true }],
  "observability": { "enabled": true },
}
